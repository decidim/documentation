#!/usr/bin/env bash

# Configuration
CONTAINER_NAME="decidim-documentation-docs-app"
SCRIPT_NAME=$(basename "$0")
CONTAINERS_TO_STOP=("decidim-documentation-docs-app-1")
DEVCONTAINER_DIR=".devcontainer"
DEVCONTAINER_JSON="$DEVCONTAINER_DIR/devcontainer.json"
DEVCONTAINER_LOCAL_JSON="$DEVCONTAINER_DIR/devcontainer.local.json"
DEVCONTAINER_BACKUP_JSON="$DEVCONTAINER_DIR/devcontainer.json.backup"
DEVCONTAINER_BACKUP_FLAG="$DEVCONTAINER_DIR/devcontainer.json.backup.managed"
DEVCONTAINER_MERGE_HASH="$DEVCONTAINER_DIR/devcontainer.json.merge.hash"
DEVCONTAINER_LOCK="$DEVCONTAINER_DIR/devcontainer.json.lock"

# Hash a file's contents, using whichever tool is available.
file_hash() {
    if command -v sha256sum &> /dev/null; then
        sha256sum "$1" | cut -d ' ' -f1
    elif command -v shasum &> /dev/null; then
        shasum -a 256 "$1" | cut -d ' ' -f1
    elif command -v cksum &> /dev/null; then
        cksum "$1"
    fi
}

# Acquire an exclusive lock so concurrent `up`/`rebuild` runs cannot clobber
# each other's backup, flag and hash files. Released by release_config_lock.
# Falls back to a best-effort mkdir lock when flock is unavailable.
CONFIG_LOCK_DIR=""
CONFIG_LOCK_FD=""
CONFIG_LOCK_HELD=0
acquire_config_lock() {
    if [ "$CONFIG_LOCK_HELD" = "1" ]; then
        return 0
    fi
    if command -v flock &> /dev/null; then
        exec {CONFIG_LOCK_FD}> "$DEVCONTAINER_LOCK"
        if ! flock -w 600 "$CONFIG_LOCK_FD"; then
            echo "Error: Could not acquire the devcontainer configuration lock." >&2
            return 1
        fi
        CONFIG_LOCK_HELD=1
        return 0
    fi
    CONFIG_LOCK_DIR="${DEVCONTAINER_LOCK}.d"
    local waited=0
    while ! mkdir "$CONFIG_LOCK_DIR" 2> /dev/null; do
        if [ "$waited" -ge 600 ]; then
            echo "Error: Could not acquire the devcontainer configuration lock." >&2
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
    CONFIG_LOCK_HELD=1
    return 0
}

release_config_lock() {
    if [ "$CONFIG_LOCK_HELD" != "1" ]; then
        return 0
    fi
    if [ -n "$CONFIG_LOCK_FD" ]; then
        flock -u "$CONFIG_LOCK_FD" 2> /dev/null || true
        eval "exec ${CONFIG_LOCK_FD}>&-" 2> /dev/null || true
        CONFIG_LOCK_FD=""
    fi
    if [ -n "$CONFIG_LOCK_DIR" ]; then
        rmdir "$CONFIG_LOCK_DIR" 2> /dev/null || true
        CONFIG_LOCK_DIR=""
    fi
    CONFIG_LOCK_HELD=0
}

# Restore the original configuration from a backup left by an interrupted run
# (or by the current run) and clear the companion state files.
#
# Only a backup this script created is used, and the original is only restored
# when the current file still matches the merged output that run wrote, so a
# configuration edited during the run is never discarded. Set FORCE_RESTORE=1
# to skip the change check (used on the interruption trap to guarantee the
# pre-run configuration is restored).
recover_previous_config() {
    if [ ! -f "$DEVCONTAINER_BACKUP_FLAG" ] || [ ! -f "$DEVCONTAINER_BACKUP_JSON" ]; then
        # No usable backup; drop any stale companions.
        rm -f "$DEVCONTAINER_BACKUP_JSON" "$DEVCONTAINER_BACKUP_FLAG" "$DEVCONTAINER_MERGE_HASH"
        return 0
    fi
    if [ "${FORCE_RESTORE:-0}" != "1" ] \
        && [ -f "$DEVCONTAINER_MERGE_HASH" ] \
        && [ "$(file_hash "$DEVCONTAINER_JSON")" != "$(cat "$DEVCONTAINER_MERGE_HASH")" ]; then
        echo "Warning: $DEVCONTAINER_JSON was edited since it was merged; keeping the current configuration." >&2
        rm -f "$DEVCONTAINER_BACKUP_JSON" "$DEVCONTAINER_BACKUP_FLAG" "$DEVCONTAINER_MERGE_HASH"
        return 0
    fi
    mv "$DEVCONTAINER_BACKUP_JSON" "$DEVCONTAINER_JSON"
    rm -f "$DEVCONTAINER_BACKUP_FLAG" "$DEVCONTAINER_MERGE_HASH"
}

# Restore the original devcontainer config. Safe to call from any command:
# the lock is acquired when not already held by the caller.
restore_devcontainer_config() {
    local acquired=0
    if [ "$CONFIG_LOCK_HELD" != "1" ]; then
        if ! acquire_config_lock; then
            return 1
        fi
        acquired=1
    fi
    recover_previous_config
    if [ "$acquired" = "1" ]; then
        release_config_lock
    fi
}

# Function to use local config if it exists
#
# This allows having a file with local instructions for your personal developer environment at
# .devcontainer/devcontainer.local.json
# So, for instance, you can have
#
# {
#   "postCreateCommand": ".devcontainer/devcontainer.local.postCreateCommand.bash"
# }
#
# And there you can add your own packages, dotfiles, etc. Do not forget to also call `bin/setup`
# at the end of your script.
#
use_local_config() {
    if [ -f "$DEVCONTAINER_LOCAL_JSON" ]; then
        # Check if jq is available
        if command -v jq &> /dev/null; then
            echo "Merging devcontainer.local.json with devcontainer.json..." >&2

            # Serialize config mutation so concurrent runs cannot clobber each
            # other's backup, flag and hash files.
            if ! acquire_config_lock; then
                return 1
            fi

            # Recover an interrupted run's original config before taking a new
            # backup. Deleting it here would lose the only clean copy and cause
            # the already-merged file to be backed up instead.
            recover_previous_config

            # Backup the current (original) configuration. The flag file marks
            # this backup as owned by us, so restore only happens for backups we
            # created.
            cp "$DEVCONTAINER_JSON" "$DEVCONTAINER_BACKUP_JSON"
            : > "$DEVCONTAINER_BACKUP_FLAG"

            # Merge configs: base config with local overrides
            # jq -s '.[0] * .[1]' merges two objects, with the second overriding the first
            if jq -s '.[0] * .[1]' "$DEVCONTAINER_BACKUP_JSON" "$DEVCONTAINER_LOCAL_JSON" > "$DEVCONTAINER_JSON"; then
                # Remember the merged result so a later restore can tell whether
                # the developer edited the file while the command was running.
                file_hash "$DEVCONTAINER_JSON" > "$DEVCONTAINER_MERGE_HASH"
                release_config_lock
                return 0
            else
                echo "Error: Failed to merge JSON configs. Restoring backup..." >&2
                restore_devcontainer_config
                release_config_lock
                return 1
            fi
        else
            echo "Warning: jq not found. Install jq to use devcontainer.local.json." >&2
            return 1
        fi
    fi
    return 1
}

# Check if devcontainer CLI is installed
if ! command -v devcontainer &> /dev/null; then
    echo "devcontainer CLI not found. Installing..."
    npm install -g @devcontainers/cli

    # Check if installation was successful
    if ! command -v devcontainer &> /dev/null; then
        echo "Error: Failed to install devcontainer CLI"
        exit 1
    fi
    echo "devcontainer CLI installed successfully"
fi

# Handle commands that don't need container ID first
case "$1" in
    up)
        if use_local_config; then
            :
        elif [ -f "$DEVCONTAINER_LOCAL_JSON" ]; then
            echo "Error: Failed to apply devcontainer.local.json." >&2
            exit 1
        fi
        # On interruption, leave the configuration as it was before the run.
        trap 'FORCE_RESTORE=1; restore_devcontainer_config' EXIT
        devcontainer up --workspace-folder=.
        status=$?
        trap - EXIT
        restore_devcontainer_config
        exit "$status"
        ;;
    down)
        echo "Stopping containers..."
        for container in "${CONTAINERS_TO_STOP[@]}"; do
            if docker ps -a --format "{{.Names}}" | grep -q "^${container}$"; then
                echo "Stopping $container..."
                docker stop "$container"
            else
                echo "Container $container not found, skipping..."
            fi
        done
        restore_devcontainer_config
        exit 0
        ;;
    rebuild)
        if use_local_config; then
            :
        elif [ -f "$DEVCONTAINER_LOCAL_JSON" ]; then
            echo "Error: Failed to apply devcontainer.local.json." >&2
            exit 1
        fi
        # On interruption, leave the configuration as it was before the run.
        trap 'FORCE_RESTORE=1; restore_devcontainer_config' EXIT
        devcontainer up --workspace-folder=. --remove-existing-container
        status=$?
        trap - EXIT
        restore_devcontainer_config
        exit "$status"
        ;;
    rm)
        echo "Removing all containers and cleaning up..."
        for container in "${CONTAINERS_TO_STOP[@]}"; do
            if docker ps -a --format "{{.Names}}" | grep -q "^${container}$"; then
                echo "Removing $container..."
                docker rm -f "$container"
            else
                echo "Container $container not found, skipping..."
            fi
        done
        restore_devcontainer_config
        echo "Cleanup complete!"
        exit 0
        ;;
    ps)
        echo "Checking container status..."
        echo ""
        found_any=false
        for container in "${CONTAINERS_TO_STOP[@]}"; do
            if docker ps -a --format "{{.Names}}" | grep -q "^${container}$"; then
                found_any=true
                status=$(docker ps -a --format "{{.Names}}\t{{.Status}}" | grep "^${container}\s" | cut -f2)
                echo "  $container: $status"
            fi
        done
        if [ "$found_any" = false ]; then
            echo "  No containers found"
        fi
        exit 0
        ;;
    ""| help | --help | -h)
        echo "Usage: $SCRIPT_NAME <command>"
        echo ""
        echo "Container Management:"
        echo "  up              - Start the devcontainer"
        echo "  down            - Stop all containers"
        echo "  rebuild         - Rebuild the devcontainer"
        echo "  rm              - Remove all containers and clean up"
        echo "  ps              - Check container status"
        echo ""
        echo "Execute Commands:"
        echo "  $SCRIPT_NAME <command>                 Execute any command in the container"
        echo ""
        echo "Examples:"
        echo "  $SCRIPT_NAME npm install               - Run npm install"
        echo "  $SCRIPT_NAME npm run build             - Build the documentation"
        echo "  $SCRIPT_NAME npm run test              - Run tests"
        exit 0
        ;;
esac

# Get the container ID for decidim-documentation-docs-app
container_id=$(docker ps --filter "name=$CONTAINER_NAME" --format "{{.ID}}" | head -n 1)

# Check if container was found
if [ -z "$container_id" ]; then
    echo "Error: $CONTAINER_NAME container not found. Start it with '$SCRIPT_NAME up'"
    exit 1
fi

# Check if the command exists in ./bin directory
if [ -f "./bin/$1" ] && [ -x "./bin/$1" ]; then
    # If it's a script in bin/, prepend bin/ to the path
    devcontainer exec --container-id "$container_id" --workspace-folder=. "bin/$@"
else
    # Otherwise execute the command as-is
    devcontainer exec --container-id "$container_id" --workspace-folder=. "$@"
fi
